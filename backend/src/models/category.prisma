model Category {
    id        Int       @id @default(autoincrement())
    name      String    @db.VarChar(100)
    status    Boolean   @default(true)
    product   Product[]
    createdAt DateTime  @default(now()) @db.Timestamp()
    updatedAt DateTime  @default(now()) @updatedAt @db.Timestamp()

    @@map("categories")
}
